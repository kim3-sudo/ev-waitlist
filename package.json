{
  "name": "plugyard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "docs:api:lint": "redocly lint openapi/openapi.yaml",
    "docs:api:build": "node scripts/build-api-docs.mjs",
    "build": "npm run docs:api:build && npm run build --workspace web",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test": "npm test --workspace server",
    "simulate:idp": "npm run simulate:idp --workspace server"
  },
  "devDependencies": {
    "@redocly/cli": "2.71.2"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "qs": "^6.17.1",
    "proxy-addr": "^2.0.8",
    "follow-redirects": "^1.16.3",
    "source-map-js": "^1.2.2"
  }
}
