# Only what the server needs before it can reach the database lives here.
# Everything else -- web addresses, the reservation window, and payment provider
# keys -- is set in the admin app (Admin > System and Admin > Integrations).

# SQLite database, kept in <project root>/data (the path is relative to server/prisma).
DATABASE_URL="file:../../data/dev.db"
PORT=4000

# Optional. If unset, the server generates these on first start and keeps them in
# data/secrets.json (mode 0600). Back that file up: losing the encryption
# key makes saved payment secrets unreadable. To set your own, use a long random
# value (for example:  openssl rand -base64 32). Placeholder values are refused.
# JWT_SECRET="..."          Signs login sessions.
# CONFIG_ENCRYPTION_KEY="..." Encrypts secret keys stored in the database.

# Optional first-run seeds. Set once, these are copied into the database the first
# time the server starts, and the admin app takes over after that. Remove them
# once you have confirmed the admin app shows the right values.
# PUBLIC_URL="http://localhost:4000"
# CORS_ORIGIN="http://localhost:5173"
# WEB_PUBLIC_URL="http://localhost:5173"
# RESERVATION_WINDOW_MINUTES=15
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# BRAINTREE_ENVIRONMENT="sandbox"
# BRAINTREE_MERCHANT_ID=""
# BRAINTREE_PUBLIC_KEY=""
# BRAINTREE_PRIVATE_KEY=""
# SQUARE_ENVIRONMENT="sandbox"
# SQUARE_ACCESS_TOKEN=""
# SQUARE_LOCATION_ID=""
# SQUARE_WEBHOOK_SIGNATURE_KEY=""
# SQUARE_WEBHOOK_URL=""
