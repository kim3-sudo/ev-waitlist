# Only what the server needs before it can reach the database lives here.
# Everything else -- web addresses, the reservation window, and payment provider
# keys -- is set in the admin app (Admin > System and Admin > Integrations).

DATABASE_URL="file:./dev.db"
PORT=4000

# Signs login sessions. Use a long random string, and keep it private.
JWT_SECRET="change-me-to-a-long-random-string"

# Encrypts secret keys (such as payment provider secrets) before they're saved
# in the database. Generate one with:  openssl rand -base64 32
# Keep it: if it changes, saved secrets can't be read and must be entered again.
CONFIG_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Optional first-run seeds. Set once, these are copied into the database the first
# time the server starts, and the admin app takes over after that. Remove them
# once you have confirmed the admin app shows the right values.
# PUBLIC_URL="http://localhost:4000"
# CORS_ORIGIN="http://localhost:5173"
# WEB_PUBLIC_URL="http://localhost:5173"
# RESERVATION_WINDOW_MINUTES=15
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# BRAINTREE_ENVIRONMENT="sandbox"
# BRAINTREE_MERCHANT_ID=""
# BRAINTREE_PUBLIC_KEY=""
# BRAINTREE_PRIVATE_KEY=""
# SQUARE_ENVIRONMENT="sandbox"
# SQUARE_ACCESS_TOKEN=""
# SQUARE_LOCATION_ID=""
# SQUARE_WEBHOOK_SIGNATURE_KEY=""
# SQUARE_WEBHOOK_URL=""
