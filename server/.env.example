DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"

# Externally-reachable base URL of this server (used to build the SAML SP's
# entity ID and ACS URL -- must match what you register with the IdP)
PUBLIC_URL="http://localhost:4000"

# Minutes a reserved slot stays held before the next person in line gets it
RESERVATION_WINDOW_MINUTES=15

# Seed admin (used by prisma/seed.js)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
