generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single row (id always "singleton") for the whole installation: the operator
// that runs it. Its country code and party ID are used only by OCPI, and are
// blank until an operator sets them.
model Operator {
  id          String   @id @default("singleton")
  name        String   @default("")
  countryCode String   @default("")
  partyId     String   @default("")
  updatedAt   DateTime @updatedAt
}

// A site. Every tenant-scoped row belongs to exactly one site. An installation
// with a single site uses the tenant with id "default" and never sees the
// tenant concept in the UI.
model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Roaming (OCPI) is off until the admin acknowledges the roaming terms.
  roamingEnabled                  Boolean   @default(false)
  roamingTermsAcknowledgedAt      DateTime?
  roamingTermsAcknowledgedBy      String?
  roamingTermsAcknowledgedVersion String?
  // Extra text the site adds to the roaming warning. The required core text is always shown.
  roamingWarningExtra             String? // @longtext

  // Load balancing: the site supply in kW shared across the charge points that have smart charging on.
  // Off until an admin turns it on (see services/loadBalance.js).
  loadBalancingEnabled            Boolean   @default(false)
  siteCapacityKw                  Float?
  // Smart charging depth, as JSON: the time zone, the phase capacity, time-of-day schedules and
  // dynamic events (see services/smartCharging.js). Null until an admin sets it.
  smartChargingConfig             String?   // @longtext
  // Retention, in days after a queue entry closes (personal data).
  queueRetentionDays     Int  @default(30)
  // Retention, in days, for payer details on charges. Null keeps them indefinitely.
  financialRetentionDays Int? @default(30)

  // Where the site is, for the charger locator (see services/locator.js). The
  // pin on the map. Stations keep their own coordinates.
  address          String?
  city             String?
  postalCode       String?
  country          String?
  latitude         Float?
  longitude        Float?
  // Opening hours in free text (e.g. "24/7") and a comma-separated list of amenities.
  hours            String?
  amenities        String?
  // Structured amenities and parking the site offers, as JSON lists of keys (see
  // services/siteFeatures.js). Access-controlled sites, such as a workplace lot, need permission to enter.
  amenityKeys      String? // @longtext
  parkingKeys      String? // @longtext
  accessControlled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins                Admin[]
  customRoles           CustomRole[]
  zones                 Zone[]
  stations              Station[]
  driverVehicles        DriverVehicle[]
  driverSignInCodes     DriverSignInCode[]
  walletCredentials     WalletCredential[]
  queueEntries          QueueEntry[]
  reservations          Reservation[]
  transactions          Transaction[]
  charges               Charge[]
  idleEvents            IdleEvent[]
  meterSamples          MeterSample[]
  stationEvents         StationEvent[]
  lineCuttingComplaints LineCuttingComplaint[]
  settings              Settings?
  paymentSettings       PaymentSettings?
  samlConfig            SamlConfig?
  configValues          ConfigValue[]
  ocpiPartners          OcpiPartner[]
  ocpiTokens            OcpiToken[]
  ocpiOutbox            OcpiOutbox[]
  paymentHolds          PaymentHold[]
  messageTemplates      MessageTemplate[]
  alerts                Alert[]
  priceRules            PriceRule[]
  serviceAccounts       ServiceAccount[]
  apiKeys               ApiKey[]
  providerOutages       ProviderOutage[]
  auditEvents           AuditEvent[]
  localListEntries      LocalListEntry[]
  firmwarePackages      FirmwarePackage[]
  diagnosticsLogs       DiagnosticsLog[]
  taxRules              TaxRule[]
  billingSettings       BillingSettings?
  billingCustomers      BillingCustomer[]
  invoices              Invoice[]
  receipts              Receipt[]
  documentCounters      DocumentCounter[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  subscriptionPlans     SubscriptionPlan[]
  subscriptions         Subscription[]
}

model Admin {
  id                 String          @id @default(cuid())
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  tenantId           String
  email              String          @unique
  // The identity this account has at the SAML identity provider, when it is
  // not the email (persistent or unspecified NameID). Unique within a site.
  samlNameId         String?
  // Null for SSO-only accounts that authenticate exclusively via SAML.
  passwordHash       String?
  mfaSecret          String?
  mfaEnabled         Boolean         @default(false)
  // Driver details, kept on the account. A driver account is an account with the DRIVER role
  // (see auth/permissions.js), so admins can also be drivers with the same e-mail.
  name               String?
  phone              String?
  driverVehicles     DriverVehicle[]
  // Wallet pass credentials this account holds (see services/wallet).
  walletCredentials  WalletCredential[]
  queueEntries       QueueEntry[]
  // Alerts this admin chooses to receive by e-mail (see services/adminAlerts.js).
  alertOnFault       Boolean         @default(false)
  alertOffline       Boolean         @default(false)
  // Set on the auto-generated first-run admin. Blocks all admin API access
  // until the password is changed.
  mustChangePassword Boolean         @default(false)
  // Role name: a built-in role (ADMIN, VIEWER -- see auth/permissions.js) or
  // the name of a CustomRole in the same site. Permissions are resolved from it on each request.
  role               String          @default("ADMIN")
  // The installation administrator (the person who set up the software). Only this
  // account can create and manage sites.
  instanceAdmin      Boolean         @default(false)
  createdAt          DateTime        @default(now())

  @@unique([tenantId, samlNameId])
  @@index([tenantId])
}

// One row per site (keyed by tenant): white-label branding and
// waitlist-identifier configuration.
model Settings {
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  tenantId                String   @id
  companyName             String   @default("Plugyard")
  logoUrl                 String? // @longtext
  primaryColor            String   @default("#0d7a5f")
  secondaryColor          String   @default("#1565c0")
  fontFamily              String?
  // JSON: { sets: [built-in set ids], custom: [{ code, name }] } -- the license plate
  // regions the join form offers. Null means the default sets.
  plateRegions            String? // @longtext
  // Code of the region the join form selects first (one of the offered regions).
  defaultPlateRegion      String?
  // LICENSE_PLATE | PARKING_PERMIT | BOTH -- which identifier(s) the public
  // waitlist join form collects.
  identifierMode          String   @default("LICENSE_PLATE")
  // When true, admin accounts without MFA enabled are forced to enroll
  // (TOTP) the next time they log in.
  mfaRequired             Boolean  @default(false)
  // False until the first-run setup wizard (first charge point + branding)
  // is completed or skipped.
  setupCompleted          Boolean  @default(false)
  // JSON: { emails: [], phones: [], contactFormUrl: "" } -- the help details the
  // "Help" tab shows drivers. Set on the About page. Null means none given yet.
  helpContacts            String? // @longtext
  // Whether a waitlist join needs contact details (an e-mail address or mobile number).
  waitlistContactRequired Boolean  @default(true)
  // OPTIONAL: guests can join and start charging; signed-in drivers get their details filled in.
  // REQUIRED: a driver must sign in to join the waitlist or start charging.
  driverAccounts          String   @default("OPTIONAL")
  updatedAt               DateTime @updatedAt
}

// One row per site: the site's SAML service-provider configuration for a
// single external identity provider.
model SamlConfig {
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  tenantId          String   @id
  enabled           Boolean  @default(false)
  idpEntityId       String?
  idpSsoUrl         String?
  idpCertificate    String? // @longtext
  // When true, a SAML assertion for an identity with no matching Admin
  // auto-creates an SSO-only account. When false, that login is rejected.
  autoProvision     Boolean  @default(false)
  // Which NameID format identifies a user: "emailAddress", "persistent" or
  // "unspecified". For emailAddress the NameID is the email; otherwise the
  // NameID is stored on Admin.samlNameId and the email comes from an attribute.
  nameIdFormat      String   @default("emailAddress")
  // Name of the assertion attribute that lists the user's groups. Null turns
  // group-based roles off, and roles are left as they are.
  groupAttribute    String?
  // JSON array of { "group": string, "role": string }, in priority order: the
  // first entry whose group the user belongs to sets the role.
  groupRoleMappings String   @default("[]") // @longtext
  // Role for a user in none of the mapped groups. Null denies login to those
  // users. Only used when groupAttribute is set.
  defaultRole       String?  @default("VIEWER")
  updatedAt         DateTime @updatedAt
}

// A group of stations (e.g. "Parking Garage P1") that share a single
// waitlist -- whichever station in the zone frees a connector first serves
// the next person in the zone's line, rather than each station keeping its
// own separate line.
model Zone {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  stations     Station[]
  queueEntries QueueEntry[]
  priceRules   PriceRule[]

  @@unique([tenantId, name])
}

model Station {
  id                String    @id @default(cuid())
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  tenantId          String
  // Whether this charge point has an NFC reader that accepts wallet passes (see services/wallet).
  walletTap         Boolean   @default(false)
  // Features this charge point supports, chosen by the admin when the charge point is set up.
  // The server sends a feature's messages only when its flag is on, so hardware that lacks a
  // feature never receives a message it cannot answer.
  smartChargingEnabled  Boolean @default(false)
  firmwareUpdateEnabled Boolean @default(false)
  localListEnabled      Boolean @default(false)
  // OCPP "identity" -- the charge point ID used in the websocket URL
  // (ws://host:port/ocpp/<identity>) and in every OCPP message exchange.
  identity          String    @unique
  name              String
  vendor            String?
  model             String?
  location          String?
  // Coordinates shown to roaming partners. Blank stations are not published.
  latitude          Float?
  longitude         Float?
  // Locator details. Blank values fall back to the site's (see services/locator.js).
  city              String?
  postalCode        String?
  country           String?
  hours             String?
  amenities         String?
  // Optional notes an admin writes for drivers (e.g. where the charger is). Shown in the waitlist's Help tab.
  tips              String? // @longtext
  // Parking the charge point has, as a JSON list of keys (see services/siteFeatures.js).
  parkingKeys       String? // @longtext
  // What the charge point reported when it booted (BootNotification) and since then.
  serialNumber      String?
  firmwareVersion   String?
  // Last time any message arrived from the charge point (written at most once a minute).
  lastSeenAt        DateTime?
  // When the charge point last disconnected, and whether an offline alert was sent for it.
  offlineSince      DateTime?
  offlineAlertSent  Boolean   @default(false)
  // Latest FirmwareStatusNotification and DiagnosticsStatusNotification values.
  firmwareStatus    String?
  diagnosticsStatus String?
  // Whether the charge point reports meter values: UNKNOWN, CONFIGURED (we set the
  // sampling), REPORTING (readings have arrived), or NONE (no meter on the charger).
  meterStatus       String    @default("UNKNOWN")
  // Last GetConfiguration result (JSON), so the page can show it while offline.
  configurationJson String? // @longtext
  configurationAt   DateTime?
  // Null for a standalone station with its own waitlist.
  zone              Zone?     @relation(fields: [zoneId], references: [id])
  zoneId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connectors            Connector[]
  queueEntries          QueueEntry[]
  reservations          Reservation[]
  transactions          Transaction[]
  lineCuttingComplaints LineCuttingComplaint[]
  idleEvents            IdleEvent[]
  meterSamples          MeterSample[]
  events                StationEvent[]
  charges               Charge[]
  alerts                Alert[]
  priceRules            PriceRule[]
  diagnosticsLogs       DiagnosticsLog[]

  @@index([tenantId])
}

model Connector {
  id              String   @id @default(cuid())
  station         Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId       String
  // OCPP connectorId (0 = whole station, 1..n = physical connectors)
  connectorId     Int
  status          String   @default("Unavailable")
  errorCode       String?
  // Connector details published to roaming partners (OCPI). Blank until entered; a
  // station is only published once all its connectors have them.
  standard        String?
  format          String?
  powerType       String?
  maxVoltage      Int?
  maxAmperage     Int?
  // Wiring, for phase-aware balancing: 1 (single-phase) or 3 (three-phase), and for a single-phase
  // connector the phase it is wired to (L1, L2 or L3). Blank means unknown (see smartCharging.js).
  phaseCount      Int?
  phase           String?
  // The manual limit an admin set on this connector (the charge point holds it too). It is a
  // ceiling for load balancing and schedules: the balance never goes above it. Null when none is set.
  manualLimitAmps Int?
  // Free-text detail from the last StatusNotification (its info and vendorErrorCode fields).
  info            String?
  vendorErrorCode String?
  // The admin's intent: false takes the connector out of service for dispatch. The
  // charge point's own state arrives separately as status.
  operative       Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@unique([stationId, connectorId])
}

// A person waiting in line for a station -- or, for a zoned station, for the
// zone as a whole. Independent of which physical connector they eventually
// get -- the dispatcher assigns that at match time.
//
// Exactly one of (stationId, zoneId) is set at join time: joining a
// standalone station's waitlist sets stationId; joining a zone's shared
// waitlist sets zoneId instead, and stationId is filled in once the
// dispatcher matches the entry to a specific station's freed connector.
model QueueEntry {
  id            String    @id @default(cuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  tenantId      String
  station       Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId     String?
  zone          Zone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId        String?
  name          String
  contact       String
  // The driver account that joined, when the driver was signed in. Null for guests.
  accountId     String?
  account       Admin?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Optional mobile number for text messages, set when the driver elects SMS.
  smsNumber     String?
  idTag         String
  licensePlate  String?
  // The region the plate belongs to (for example "US-CA" or "DE").
  plateRegion   String?
  parkingPermit String?
  // WAITING -> NOTIFIED -> COMPLETED
  //         -> EXPIRED / CANCELLED
  status        String    @default("WAITING")
  position      Int
  createdAt     DateTime  @default(now())
  // Set when the entry reaches COMPLETED, EXPIRED or CANCELLED. Retention is counted from here.
  closedAt      DateTime?

  reservation           Reservation?
  lineCuttingComplaints LineCuttingComplaint[]

  @@index([tenantId])
  @@index([accountId])
}

// A hold placed on a specific connector for a specific queue entry, mirrored
// (when the station supports it) by an OCPP ReserveNow call.
model Reservation {
  id                String      @id @default(cuid())
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  tenantId          String
  // Null for a manual hold placed by an admin (no waitlist entry).
  queueEntry        QueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  queueEntryId      String?     @unique
  // Manual holds only: the ID tag allowed to start on the held connector, a note, and who placed it.
  idTag             String?
  note              String?
  createdByAdminId  String?
  station           Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId         String
  connectorId       Int
  // Null when the charge point doesn't support ReserveNow and we fall back
  // to a soft (app-only) hold.
  ocppReservationId Int?
  expiresAt         DateTime
  // ACTIVE -> FULFILLED / EXPIRED / CANCELLED
  status            String      @default("ACTIVE")
  createdAt         DateTime    @default(now())

  @@index([tenantId])
}

// A driver's complaint that someone else took their spot at a station
// (e.g. plugged in without having been notified/reserved). Surfaced to
// admins to review and act on manually. Table name is kept from the older
// "LineCutterReport" model.
model LineCuttingComplaint {
  id           String     @id @default(cuid())
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantId     String
  station      Station    @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId    String
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  queueEntryId String
  note         String? // @longtext
  // OPEN -> RESOLVED / DISMISSED
  status       String     @default("OPEN")
  createdAt    DateTime   @default(now())
  // Set when the complaint leaves OPEN; cleared if it is reopened.
  resolvedAt   DateTime?

  @@index([tenantId])
  @@map("LineCutterReport")
}

model Transaction {
  id                String    @id @default(cuid())
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  tenantId          String
  station           Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId         String
  connectorId       Int
  idTag             String
  ocppTransactionId Int
  // The transaction ID a charge point chose under OCPP 2.0.1 (text). Null for OCPP 1.6 sessions.
  ocppTransactionRef String?
  meterStart        Int?
  meterStop         Int?
  startedAt         DateTime  @default(now())
  stoppedAt         DateTime?
  // OCPP StopTransaction reason (Local, Remote, EVDisconnected, PowerLoss, ...), or Stale
  // when the session was closed by the stale-session sweep.
  stopReason        String?
  charge            Charge?
  // The roaming partner whose token started this session, if any. Roaming sessions are
  // billed by the partner through a CDR, not by a payment link.
  partnerId         String?

  @@index([tenantId])
}

// A stretch of time a connector sat occupied after the session was over
// (status Finishing, or SuspendedEV with no open transaction) -- i.e. a car
// still plugged in once charging has finished. endedAt is null while ongoing.
model IdleEvent {
  id          String    @id @default(cuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId   String
  connectorId Int
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([stationId, connectorId, endedAt])
  @@index([tenantId])
}

// One reading from a charge point's MeterValues message. Values are normalized on the
// way in: energy in Wh, power in W, current in A, voltage in V, state of charge in
// percent, temperature in Celsius. Kept briefly, for live readings and the billing check.
model MeterSample {
  id                String   @id @default(cuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  tenantId          String
  station           Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId         String
  connectorId       Int
  // The OCPP transaction the reading belongs to, when the charge point sent one.
  ocppTransactionId Int?
  measurand         String
  context           String?
  value             Float
  at                DateTime

  @@index([stationId, ocppTransactionId])
  @@index([stationId, connectorId, measurand, at])
  @@index([tenantId])
}

// Something that happened at a charge point, for the station's history: boots, faults,
// firmware and diagnostics steps, commands sent by an admin, and offline or back-online changes.
model StationEvent {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId   String
  connectorId Int?
  // BOOT, FAULT, FIRMWARE, DIAGNOSTICS, COMMAND, CONFIG, SESSION, OFFLINE, ONLINE
  kind        String
  detail      String
  // The admin who sent the command, when there was one.
  actorId     String?
  at          DateTime @default(now())

  @@index([stationId, at])
  @@index([tenantId])
}

// A named set of permissions an admin can assign to users (e.g. "Electrician").
// The built-in ADMIN and VIEWER roles are defined in code, not stored here.
model CustomRole {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  description String?
  // JSON array of permission keys from auth/permissions.js.
  permissions String   @default("[]") // @longtext
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

// A non-human principal for the REST API (/api/v1). It holds only api.* permissions
// and authenticates with one or more API keys.
model ServiceAccount {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  description String?
  // JSON array of api.* permission keys from auth/permissions.js.
  permissions String   @default("[]") // @longtext
  // A disabled account's keys stop working, but they can be re-enabled.
  disabled    Boolean  @default(false)
  // The admin who created the account. Kept as text so the row survives if that admin is removed.
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  keys        ApiKey[]

  @@unique([tenantId, name])
}

// An API key. Only its SHA-256 hash is stored; the full key is shown once, at creation.
model ApiKey {
  id               String         @id @default(cuid())
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  tenantId         String
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  serviceAccountId String
  name             String
  // The first characters of the key, shown in the admin UI to tell keys apart.
  prefix           String
  keyHash          String         @unique
  expiresAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@index([tenantId])
  @@index([serviceAccountId])
}

// One row per audit event. The events form a single hash chain across the whole
// installation: each row's hash covers its own fields and the previous row's hash,
// so changing or removing a row breaks the chain (see audit/chain.js).
model AuditEvent {
  id          String    @id @default(cuid())
  // 1, 2, 3 ... across the installation. The chain is ordered by this.
  seq         Int       @unique
  at          DateTime  @default(now())
  // Null for installation-wide events (sites, the operator, network-wide settings).
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId    String?
  // ADMIN, SERVICE_ACCOUNT, ANONYMOUS, or SYSTEM.
  actorType   String
  actorId     String?
  // The name or e-mail at the time, so the entry still reads correctly after the actor is removed.
  actorLabel  String?
  // Dotted, e.g. service_account.key.revoke.
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  // SUCCESS, DENIED, or FAILED.
  outcome     String
  reason      String?
  // JSON: field-level before and after values. Secret fields are recorded as [set] or [cleared].
  changes     String? // @longtext
  // Address at the logging level chosen in AuditSettings: full, truncated, or none.
  ip          String?
  userAgent   String?
  requestId   String?
  prevHash    String
  hash        String    @unique
  // When the event was delivered to the syslog/SIEM exporter. Null if it has not been.
  exportedAt  DateTime?

  @@index([tenantId, seq])
  @@index([action])
  @@index([at])
  @@index([exportedAt])
}

// Installation-wide audit settings (a singleton row, id "singleton").
model AuditSettings {
  id            String   @id @default("singleton")
  // How long events are kept. Events that have not yet been exported are kept regardless.
  retentionDays Int      @default(30)
  // FULL, TRUNCATED (IPv4 to /24, IPv6 to /48), or NONE.
  ipLogging     String   @default("TRUNCATED")
  updatedAt     DateTime @updatedAt
}

// One row per site: how drivers are charged and who collects payment.
model PaymentSettings {
  tenant                      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId                    String    @id
  // TIME (per minute) | ENERGY (per kWh dispensed) | FREE (drivers are not charged)
  pricingModel                String    @default("TIME")
  // ISO 4217 code, e.g. USD
  currency                    String    @default("USD")
  // The time unit for TIME pricing: MINUTE (every started minute is billed) or HOUR
  // (every started hour is billed). Rates in this row are cents per this unit. The
  // column keeps its name from when only per-minute rates existed.
  timeBillingUnit             String    @default("MINUTE")
  ratePerMinuteCents          Int       @default(0)
  // Legacy single peak window, used only while rateSchedule is null (sites that
  // have not saved the schedule yet). Saving a schedule clears these.
  peakRatePerMinuteCents      Int?
  peakStartHour               Int?
  peakEndHour                 Int?
  ratePerKwhCents             Int       @default(0)
  // Set when an admin confirms they checked local rules on reselling power.
  energyPricingAcknowledgedAt DateTime?
  // NONE | STRIPE | BRAINTREE | SQUARE
  provider                    String    @default("NONE")
  // Time-of-day rates: a JSON list of { days: [0-6, 0 = Sunday], startHour, endHour, rate }.
  // The rate is in the pricing model's unit (cents per minute, or cents per kWh).
  // Minutes not covered by a rule use the base rate. See services/payments/rates.js.
  rateSchedule                String? // @longtext
  // Charger power used to turn a per-minute rate into a per-kWh price for the price check.
  referencePowerKw            Float?
  // Meter readings: how often the charge point samples the meter while charging, and how
  // closely its readings must match the end-of-session reading before they are used
  // (see services/payments/energyCheck.js).
  meterSampleSeconds          Int       @default(60)
  meterToleranceWh            Int       @default(100)
  meterTolerancePct           Int       @default(5)
  meterMinSessionMinutes      Int       @default(2)
  meterMaxJumpWh              Int       @default(50000)
  // Inputs to the rate calculator (JSON). Kept so the price check can use the cost basis.
  rateCalculatorInputs        String? // @longtext
  // What happens while the payment provider is unavailable (see services/payments/providerOutage.js):
  // COMPLIMENTARY (charging is free until it recovers) or LOCKOUT (no new waitlist joins or offers).
  providerOutageMode          String    @default("LOCKOUT")
  // Pre-authorization: the amount held on a waitlisted driver's card before they
  // start. Null turns holds off. The session is captured at its actual amount.
  preauthCents                Int?
  updatedAt                   DateTime  @updatedAt
}

// The amount owed for one finished charging transaction.
model Charge {
  id                String      @id @default(cuid())
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  tenantId          String
  // Unguessable token in the public payment link (/pay/<token>).
  token             String      @unique
  station           Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId         String
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId     String      @unique
  idTag             String
  payerName         String?
  payerContact      String?
  // The driver's mobile number for text messages, if they elected SMS.
  payerSmsNumber    String?
  pricingModel      String
  currency          String
  // The amount still to pay (after any hold capture): the session total minus holdCapturedCents.
  amountCents       Int
  // The whole session before tax, and the tax on it (see services/tax.js). netCents is null for charges made before tax existed.
  netCents          Int?
  taxCents          Int       @default(0)
  // Each tax rule that applied, as JSON (see services/tax.js).
  taxJson           String?   // @longtext
  durationSeconds   Int
  energyWh          Int?
  // Where energyWh came from: METER_VALUES (the charger's readings, checked against the
  // stop reading), STOP_TRANSACTION, or NONE. energyNote explains a review.
  energySource      String?
  energyNote        String?
  // Set when a price change (surge or complimentary) changed the amount: a short
  // summary for the admin charges list. See services/payments/priceRules.js.
  pricingNote       String?
  // PENDING -> PAID. NEEDS_REVIEW: no meter reading to bill from.
  // NO_CHARGE: amount came to zero.
  status            String      @default("PENDING")
  // Provider used for the most recent payment attempt, and its reference
  // (Stripe Checkout Session ID or Braintree transaction ID).
  provider          String?
  providerRef       String?
  paidAt            DateTime?
  // Amount already captured from a pre-authorization hold. amountCents is then
  // only the balance still owed (the session cost minus this amount).
  holdCapturedCents Int         @default(0)
  // A subscription discount taken off the price before tax, and the plan it came from.
  discountCents     Int         @default(0)
  subscriptionId    String?
  // Set when the charge is reversed (status REVERSED). The reason is required.
  reversedAt        DateTime?
  reversalReason    String?     // @longtext
  createdAt         DateTime    @default(now())

  @@index([tenantId])
}

// A card hold placed before a waitlisted driver starts charging (pre-authorization).
// The hold is captured at the session's actual cost when it stops, and released if
// the session never starts.
model PaymentHold {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  // Unguessable token in the public hold link (/pay/hold/<token>).
  token         String   @unique
  idTag         String
  payerName     String?
  payerContact  String?
  amountCents   Int
  currency      String
  // AWAITING (link sent, card not yet held) -> HELD -> IN_USE (session started)
  // -> CAPTURED. RELEASED: the hold was let go. FAILED: the provider refused it.
  status        String   @default("AWAITING")
  provider      String?
  // Stripe Checkout Session ID while the driver is on the hosted page.
  sessionRef    String?
  // Stripe PaymentIntent ID, or Braintree transaction ID.
  providerRef   String?
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, idTag])
}

// A notice about charge points, shown to drivers and admins while it is active.
// Scope decides what it is about: the whole network (every site), this site, the
// charge points at one location (matched on Station.location), or one charge point.
model Alert {
  id               String    @id @default(cuid())
  // Null for a network-wide alert (set by the installation administrator; it is
  // shown on every site).
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String?
  // NETWORK | SITE | LOCATION | STATION
  scope            String
  station          Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId        String?
  // LOCATION scope: the charge points whose location text equals this.
  location         String?
  // INFO | WARNING
  severity         String    @default("INFO")
  message          String // @longtext
  startsAt         DateTime  @default(now())
  // Null: the alert stays until it is removed.
  endsAt           DateTime?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([stationId])
}

// A stretch of time the site's payment provider was judged unavailable. endedAt is null
// while the outage is ongoing.
model ProviderOutage {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  provider  String
  // The last error from the health check, shortened for the admin.
  reason    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([tenantId, endedAt])
}

// A temporary change to what drivers pay. SURGE raises or lowers the price by `percent`.
// COMPLIMENTARY makes charging free. Each applies to the whole network, this site, a
// group of charge points (a zone), one charge point, or all AC or all DC connectors.
// Precedence and the time rules are in services/payments/priceRules.js.
model PriceRule {
  id               String    @id @default(cuid())
  // Null for a network-wide rule (set by the installation administrator; it applies at every site).
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String?
  // SURGE | COMPLIMENTARY
  kind             String
  // NETWORK | SITE | ZONE | STATION | POWER_TYPE
  scope            String
  zone             Zone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId           String?
  station          Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId        String?
  // POWER_TYPE scope: AC or DC.
  powerClass       String?
  // SURGE only: the change in percent. Positive raises the price, negative lowers it.
  percent          Int?
  // A short reason shown to admins and, when it is public, to drivers.
  label            String    @default("")
  startsAt         DateTime  @default(now())
  // SURGE needs an end. COMPLIMENTARY may stay on until it is turned off.
  endsAt           DateTime?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([stationId])
  @@index([zoneId])
}

// Runtime settings edited in the admin UI, one row per site and key (public
// URLs, reservation window, payment provider keys). Secret values are stored
// encrypted (see utils/secretBox.js), never in plain text.
model ConfigValue {
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  key       String
  value     String // @longtext
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}

// A roaming partner (an e-mobility provider) registered with this site. The
// tokens are hashed, except the one we send to the partner, which is encrypted
// because we need to send it again.
model OcpiPartner {
  id                    String   @id @default(cuid())
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  tenantId              String
  name                  String
  // PENDING (invited, waiting for credentials) -> ACTIVE -> REVOKED
  status                String   @default("PENDING")
  registrationTokenHash String?  @unique
  // The token the partner must send us. Only its hash is stored.
  ourTokenHash          String?  @unique
  // The token we send the partner (encrypted), and where to reach them.
  theirTokenEnc         String? // @longtext
  theirVersionsUrl      String?
  theirCountryCode      String?
  theirPartyId          String?
  // JSON map of "<identifier>:<ROLE>" -> URL, from the partner's version details.
  endpoints             String   @default("{}") // @longtext
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tokens OcpiToken[]
  outbox OcpiOutbox[]

  @@index([tenantId])
}

// A driver token the partner pushed to us (OCPI Tokens module).
model OcpiToken {
  id          String      @id @default(cuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  partner     OcpiPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId   String
  uid         String
  type        String
  contractId  String
  country     String
  party       String
  valid       Boolean     @default(true)
  whitelist   String      @default("ALLOWED")
  lastUpdated DateTime

  @@unique([partnerId, uid])
  @@index([tenantId])
}

// Messages waiting to be sent to a partner. The body is built from the database
// when the message is sent, so it always reflects the latest state.
model OcpiOutbox {
  id            String      @id @default(cuid())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  tenantId      String
  partner       OcpiPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId     String
  // SESSION | CDR | TARIFFS | EVSE_STATUS
  kind          String
  refId         String
  // PENDING -> DONE, or FAILED after too many attempts
  status        String      @default("PENDING")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

// A site's own wording for one message to drivers (for example, the "ready to charge"
// message). Only the wording a site has changed is stored. Everything else uses the
// built-in text in src/services/messageTemplates.js.
model MessageTemplate {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  // The message's key, such as READY_TO_CHARGE.
  key       String
  subject   String
  body      String // @longtext
  // The text message wording. Null means the built-in SMS text.
  smsBody   String? // @longtext
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// A vehicle a driver has added to their account, and the plugs it can charge with (including
// with an adapter). Used to show which charge points work for the driver.
model DriverVehicle {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  owner        Admin    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  name         String
  make         String?
  model        String?
  licensePlate String?
  // JSON list of connector standards (see ocpi/mappers.js CONNECTOR_STANDARDS).
  plugs        String // @longtext
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

// The tag a driver's Apple or Google Wallet pass carries. When a charge point reports it, the
// tag is translated to the driver's current waitlist tag (see services/wallet/credentialService.js).
model WalletCredential {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantId  String
  account   Admin     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  // 12 hex characters. Unique within a site, and never reused after revocation.
  idTag     String
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?

  @@unique([tenantId, idTag])
  @@index([tenantId, accountId])
}

// A one-time code a driver signs in with. Only a keyed hash is stored, and each code is used once.
model DriverSignInCode {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId, email])
}

// A firmware image an admin uploads. The file is kept on local disk under the data
// directory; the database holds its name, size and checksum.
model FirmwarePackage {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  version     String
  vendor      String?
  model       String?
  notes       String?  // @longtext
  fileName    String
  // Path of the file relative to the firmware folder under the data directory.
  storageKey  String   @unique
  sizeBytes   Int
  sha256      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// A diagnostics log requested from a charge point. The charge point uploads the file to a
// one-time address given to it, so the upload needs no admin login. Only a hash of the
// upload token is stored.
model DiagnosticsLog {
  id           String    @id @default(cuid())
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  tenantId     String
  station      Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId    String
  // REQUESTED (waiting for the upload), UPLOADED, or FAILED (the charge point reported a failure).
  status       String    @default("REQUESTED")
  tokenHash    String    @unique
  requestedAt  DateTime  @default(now())
  expiresAt    DateTime
  uploadedAt   DateTime?
  fileName     String?
  // Path relative to the diagnostics folder under the data directory.
  storageKey   String?   @unique
  sizeBytes    Int?
  sha256       String?

  @@index([tenantId])
  @@index([stationId])
}

// The business details printed on invoices and receipts, and the document numbering.
model BillingSettings {
  id               String   @id @default(cuid())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  tenantId         String   @unique
  legalName        String?
  // VAT or tax registration number, printed on every document.
  taxId            String?
  address          String?  // @longtext
  invoicePrefix    String   @default("INV")
  receiptPrefix    String   @default("RCP")
  // Days from issue to due date for invoices.
  paymentTermsDays Int      @default(30)
  // Text printed at the foot of every document.
  footerText       String?  // @longtext
  // Send receipts and invoices by e-mail. Only settable once e-mail is set up for the site.
  emailReceipts    Boolean  @default(false)
  emailInvoices    Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// A tax the admin sets up. See services/tax.js for how rules combine.
model TaxRule {
  id              String    @id @default(cuid())
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  // Free text naming the jurisdiction, shown on documents, for example "Ontario HST".
  jurisdiction    String?
  // Rate in basis points: 2000 is 20.00%.
  rateBasisPoints Int
  // EXCLUSIVE: added on top of the price. INCLUSIVE: already in the price.
  mode            String    @default("EXCLUSIVE")
  // ALL, ENERGY (energy-priced sessions) or TIME (time-priced sessions).
  appliesTo       String    @default("ALL")
  // SITE, ZONE or STATION. zoneId or stationId names the zone or charge point for the narrower scopes.
  scope           String    @default("SITE")
  zoneId          String?
  stationId       String?
  validFrom       DateTime?
  validUntil      DateTime?
  priority        Int       @default(100)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

// A business that is invoiced (B2B). Consumer receipts need no customer record.
model BillingCustomer {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  taxId     String?
  email     String?
  address   String?   // @longtext
  notes     String?   // @longtext
  // A tax-exempt business is invoiced without tax, and the invoice states the exemption reference.
  taxExempt         Boolean   @default(false)
  exemptionReference String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  subscriptions Subscription[]

  @@index([tenantId])
}

// A B2B invoice, or a credit note (kind CREDIT_NOTE, with negative lines) that corrects one.
model Invoice {
  id               String           @id @default(cuid())
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  tenantId         String
  number           String
  kind             String           @default("INVOICE")
  // ISSUED, or PAID once the admin marks it paid.
  status           String           @default("ISSUED")
  customer         BillingCustomer  @relation(fields: [customerId], references: [id])
  customerId       String
  currency         String
  netCents         Int
  taxCents         Int
  totalCents       Int
  // The supplier and customer details as they were when the invoice was issued (JSON).
  supplierSnapshot String           // @longtext
  customerSnapshot String           // @longtext
  issuedAt         DateTime         @default(now())
  dueAt            DateTime?
  paidAt           DateTime?
  // For a credit note: the invoice it corrects.
  creditsInvoiceId String?
  lines            InvoiceLine[]

  @@unique([tenantId, number])
  @@index([customerId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  // The charge this line bills. A charge is invoiced at most once.
  chargeId    String? @unique
  netCents    Int
  taxCents    Int
  totalCents  Int
  taxJson     String? // @longtext

  @@index([invoiceId])
}

// A consumer receipt, issued once a charge is paid.
model Receipt {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  number     String
  chargeId   String   @unique
  currency   String
  netCents   Int
  taxCents   Int
  totalCents Int
  taxJson    String?  // @longtext
  payerName  String?
  issuedAt   DateTime @default(now())

  @@unique([tenantId, number])
}

// The next number to use for each kind of document, per site. Numbers never repeat and never skip.
model DocumentCounter {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  kind     String
  next     Int    @default(1)

  @@unique([tenantId, kind])
}

// An ID tag the charge points keep in their local authorization list, so they can decide offline.
// ACCEPTED tags are let through without a server round trip; BLOCKED tags are refused everywhere.
model LocalListEntry {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  idTag     String
  status    String   @default("ACCEPTED")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idTag])
}

// A webhook: the URL the server posts events to, and the secret that signs each post. The secret is
// stored encrypted and shown once, when the endpoint is created.
model WebhookEndpoint {
  id          String            @id @default(cuid())
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  tenantId    String
  url         String
  // Encrypted HMAC signing secret (see utils/secretBox.js).
  secret      String            // @longtext
  // Comma-separated event types this endpoint receives, or * for all.
  events      String            @default("*")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@index([tenantId])
}

// One event for one endpoint. The dispatcher retries failed deliveries with backoff, then gives up.
model WebhookDelivery {
  id              String           @id @default(cuid())
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  tenantId        String
  endpoint        WebhookEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId      String
  eventId         String
  eventType       String
  payload         String           // @longtext
  // PENDING (waiting to send or retry), DELIVERED, or FAILED (gave up after the last retry).
  status          String           @default("PENDING")
  attempts        Int              @default(0)
  nextAttemptAt   DateTime         @default(now())
  lastStatusCode  Int?
  lastError       String?
  createdAt       DateTime         @default(now())
  deliveredAt     DateTime?

  @@index([tenantId])
  @@index([status, nextAttemptAt])
}

// A charging plan an admin defines: a monthly fee, and a discount on each session for subscribers.
model SubscriptionPlan {
  id              String         @id @default(cuid())
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  tenantId        String
  name            String
  description     String?
  monthlyFeeCents Int            @default(0)
  currency        String
  discountPercent Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]

  @@index([tenantId])
}

// A driver enrolled in a plan. Sessions by the driver's ID tag get the plan's discount. The monthly fee
// is billed to the subscriber's billing customer, when one is set.
model Subscription {
  id               String           @id @default(cuid())
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  tenantId         String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId           String
  idTag            String
  driverName       String?
  billingCustomer  BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  billingCustomerId String?
  // ACTIVE or CANCELLED.
  status           String           @default("ACTIVE")
  startedAt        DateTime         @default(now())
  cancelledAt      DateTime?
  // The billing month (YYYY-MM) the fee was last put on an invoice, so a month is billed once.
  lastBilledPeriod String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([idTag])
}
